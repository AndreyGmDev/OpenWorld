MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0a81cce62cdcaf34cb4e9ff083e3e683, type: 3}
  m_Name: 10 Quarta Sinaleira
  m_EditorClassIdentifier: 
  dialogueGroups:
  - flag: 0
    dialogueLines:
    - characterName: O.C.H.I
      characterImage: {fileID: 0}
      dialogueText: "Meu rei, o momento finalmente chegou. Essa \xE9 a \xFAltima
        sinaleira!"
    - characterName: O.C.H.I
      characterImage: {fileID: 0}
      dialogueText: "Acho que n\xE3o tem nada que eu possa te ensinar para essa sinaleira.
        Apenas use todo o conhecimento que voc\xEA adquiriu at\xE9 aqui!"
    - characterName: O.C.H.I
      characterImage: {fileID: 0}
      dialogueText: "Vai ser um belo desafio, mas voc\xEA consegue!"
    - characterName: "Jo\xE3o Ningu\xE9m"
      characterImage: {fileID: 0}
      dialogueText: "...Obrigado, OCHI. Eu vou descobrir a verdade por tr\xE1s da
        hist\xF3ria dos cangaceiros, e isso \xE9 tudo gra\xE7as a voc\xEA!\u201D
        \r\n"
    - characterName: O.C.H.I
      characterImage: {fileID: 0}
      dialogueText: "F-Finalmente, meu rei\u2026 Voc\xEA acertou o meu nome!!!"
    - characterName: O.C.H.I
      characterImage: {fileID: 0}
      dialogueText: "Fiquei at\xE9 aluado\u2026 vai com tudo, meu rei!"
    - characterName: "Jo\xE3o Ningu\xE9m"
      characterImage: {fileID: 0}
      dialogueText: Heh..., mas que estranho... Tem bastante coisa valiosa nessa
        sinaleira... Eu poderia usar...
