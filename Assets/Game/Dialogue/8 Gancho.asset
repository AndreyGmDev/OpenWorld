%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0a81cce62cdcaf34cb4e9ff083e3e683, type: 3}
  m_Name: 8 Gancho
  m_EditorClassIdentifier: 
  dialogueGroups:
  - flag: 0
    dialogueLines:
    - characterName: O.C.H.I.
      characterImage: {fileID: 0}
      dialogueText: "Olha s\xF3, meu rei! Um gancho!"
    - characterName: O.C.H.I.
      characterImage: {fileID: 0}
      dialogueText: "Voc\xEA pode usar essa engenhoca para se mover em locais que
        voc\xEA n\xE3o alcan\xE7aria normalmente, mas precisa ver se o lugar tem
        um alvo para atirar e ser puxado pra l\xE1."
    - characterName: O.C.H.I.
      characterImage: {fileID: 0}
      dialogueText: "Vamos, tente! Ah, al\xE9m disso... Esse gancho era usado para
        ajudar os cangaceiros de v\xE1rias formas, mas principalmente para locomo\xE7\xE3o."
    - characterName: "Jo\xE3o Ningu\xE9m"
      characterImage: {fileID: 0}
      dialogueText: "Ok! Por um segundo achei que era uma arma de fogo, n\xE3o sou
        f\xE3 dessas\u2026, mas j\xE1 que \xE9 s\xF3 um gancho, tudo bem!"
    - characterName: "Jo\xE3o Ningu\xE9m"
      characterImage: {fileID: 0}
      dialogueText: "\xC9 impressionante que os cangaceiros conseguiram montar isso
        h\xE1 tanto tempo."
    - characterName: O.C.H.I.
      characterImage: {fileID: 0}
      dialogueText: "Pior que sim, meu rei, \xE9 muito impressionante! "
    - characterName: O.C.H.I.
      characterImage: {fileID: 0}
      dialogueText: "No come\xE7o, eles usavam muitas tralhas para fazer essas ferramentas."
    - characterName: O.C.H.I.
      characterImage: {fileID: 0}
      dialogueText: Depois, conseguiram materiais melhores quando ajudavam o pessoal
        do Nordeste... Bom, isso foi antes da virada que deu neles...
    - characterName: "Jo\xE3o Ningu\xE9m"
      characterImage: {fileID: 0}
      dialogueText: "...Como ser\xE1 que posso me orgulhar de ser um descendente
        deles, se eles come\xE7aram a atacar pessoas inocentes?"
    - characterName: O.C.H.I.
      characterImage: {fileID: 0}
      dialogueText: "N\xE3o pense nisso, meu rei. O que t\xE1 no passado, t\xE1 no
        passado. Voc\xEA \xE9 totalmente diferente dos cangaceiros que atacavam os
        inocentes."
    - characterName: "Jo\xE3o Ningu\xE9m"
      characterImage: {fileID: 0}
      dialogueText: "...Tem raz\xE3o, obrigado, Oxi!"
    - characterName: O.C.H.I.
      characterImage: {fileID: 0}
      dialogueText: "\xC9 OCHI, meu rei!"
    - characterName: "Jo\xE3o Ningu\xE9m"
      characterImage: {fileID: 0}
      dialogueText: '*ri*'
    - characterName: O.C.H.I.
      characterImage: {fileID: 0}
      dialogueText: "Oxi... N\xE3o me diga que foi de prop\xF3sito...?"
