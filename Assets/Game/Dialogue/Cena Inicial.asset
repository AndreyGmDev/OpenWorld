%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0a81cce62cdcaf34cb4e9ff083e3e683, type: 3}
  m_Name: Cena Inicial
  m_EditorClassIdentifier: 
  dialogueGroups:
  - flag: 0
    dialogueLines:
    - characterName: "Jo\xE3o Ningu\xE9m"
      characterImage: {fileID: 21300000, guid: 7dfec1e70fb323f429c560f9b67f7d53, type: 3}
      dialogueText: "U\xE1\xE1\xE1\u2026 que sono bom\u2026!"
    - characterName: "Jo\xE3o Ningu\xE9m"
      characterImage: {fileID: 21300000, guid: 7dfec1e70fb323f429c560f9b67f7d53, type: 3}
      dialogueText: "Pelo menos as 2 horas de sono que eu tive\u2026"
    - characterName: "Jo\xE3o Ningu\xE9m"
      characterImage: {fileID: 21300000, guid: 7dfec1e70fb323f429c560f9b67f7d53, type: 3}
      dialogueText: "Bom, a espera valeu a pena! Hora de explorar aquela Sinaleira!
        \r\n"
    - characterName: "Jo\xE3o Ningu\xE9m"
      characterImage: {fileID: 21300000, guid: 7dfec1e70fb323f429c560f9b67f7d53, type: 3}
      dialogueText: "Ah, mas antes, tenho que avisar \xE0 mainha."
  - flag: 1
    dialogueLines:
    - characterName: "Jo\xE3o Ningu\xE9m"
      characterImage: {fileID: 21300000, guid: 7dfec1e70fb323f429c560f9b67f7d53, type: 3}
      dialogueText: "Mainha, t\xF4 indo na Sinaleira, prometo voltar antes da janta."
    - characterName: "M\xE3e"
      characterImage: {fileID: 21300000, guid: 7dfec1e70fb323f429c560f9b67f7d53, type: 3}
      dialogueText: "Ah, meu filho, eu sei que disse que voc\xEA podia quando fizesse
        18 anos\u2026, mas voc\xEA acabou de fazer 18\u2026"
    - characterName: "M\xE3e"
      characterImage: {fileID: 21300000, guid: 7dfec1e70fb323f429c560f9b67f7d53, type: 3}
      dialogueText: "N\xE3o quer esperar pelo menos mais uns dias?"
    - characterName: "Jo\xE3o Ningu\xE9m"
      characterImage: {fileID: 21300000, guid: 7dfec1e70fb323f429c560f9b67f7d53, type: 3}
      dialogueText: "Mas\u2026 eu j\xE1 esperei 24 horas! J\xE1 tenho 18 faz um dia.
        Por favor! Eu juro que n\xE3o vou correr riscos desnecess\xE1rios!"
    - characterName: "M\xE3e"
      characterImage: {fileID: 21300000, guid: 7dfec1e70fb323f429c560f9b67f7d53, type: 3}
      dialogueText: "Ai, meu Deus... t\xE1 bom menino..., mas tenha cuidado e n\xE3o
        saia da nossa vila..."
    - characterName: "Jo\xE3o Ningu\xE9m"
      characterImage: {fileID: 21300000, guid: 7dfec1e70fb323f429c560f9b67f7d53, type: 3}
      dialogueText: "...t\xE1..."
    - characterName: "Jo\xE3o Ningu\xE9m"
      characterImage: {fileID: 21300000, guid: 7dfec1e70fb323f429c560f9b67f7d53, type: 3}
      dialogueText: "A ilha j\xE1 \xE9 pequena e agora eu tenho que ficar nesse pedacinho
        de terra que \xE9 menor que uma noz, mas \xE9 melhor que nada."
    - characterName: "M\xE3e"
      characterImage: {fileID: 21300000, guid: 7dfec1e70fb323f429c560f9b67f7d53, type: 3}
      dialogueText: "Espero que ele n\xE3o tenha o mesmo destino que o pai... como
        m\xE3e, tenho que apoi\xE1-lo."
