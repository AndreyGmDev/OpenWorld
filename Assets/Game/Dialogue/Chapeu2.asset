MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0a81cce62cdcaf34cb4e9ff083e3e683, type: 3}
  m_Name: Chapeu2
  m_EditorClassIdentifier: 
  dialogueGroups:
  - flag: 0
    dialogueLines:
    - characterName: O.C.H.I.
      characterImage: {fileID: 0}
      dialogueText: "Muito bem, meu rei, voc\xEA conseguiu a segunda parte do chap\xE9u
        do Bandeirinha!"
    - characterName: O.C.H.I.
      characterImage: {fileID: 0}
      dialogueText: "Agora, a pr\xF3xima sinaleira \xE9 aquela mais pr\xF3xima da
        sua vila, onde os cangaceiros guardavam ferramentas e todo tipo de bugiganga."
    - characterName: "Jo\xE3o Ningu\xE9m"
      characterImage: {fileID: 0}
      dialogueText: "T\xE1 certo, Oxi! Me pergunto que tipo de inven\xE7\xE3o seguinte
        a gente vai encontrar l\xE1..."
    - characterName: O.C.H.I.
      characterImage: {fileID: 0}
      dialogueText: "Eu j\xE1 te falei... \xC9 O.C.H.I., meu Rei!"
    - characterName: "Jo\xE3o Ningu\xE9m"
      characterImage: {fileID: 0}
      dialogueText: "Esquece, vamos para a pr\xF3xima sinaleira logo, assim voc\xEA
        n\xE3o fica curioso por muito tempo."
