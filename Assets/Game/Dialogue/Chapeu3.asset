MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0a81cce62cdcaf34cb4e9ff083e3e683, type: 3}
  m_Name: Chapeu3
  m_EditorClassIdentifier: 
  dialogueGroups:
  - flag: 0
    dialogueLines:
    - characterName: O.C.H.I.
      characterImage: {fileID: 0}
      dialogueText: "Muito bem, meu rei! Agora s\xF3 falta mais uma sinaleira, a
        mais isolada da ilha."
    - characterName: O.C.H.I.
      characterImage: {fileID: 0}
      dialogueText: "De acordo com meus dados, \xE9 a sinaleira onde os cangaceiros
        guardavam tudo de valor: dinheiro, recompensas valiosas etc."
    - characterName: "Jo\xE3o Ningu\xE9m"
      characterImage: {fileID: 0}
      dialogueText: "Hmm, interessante... Vamos logo! Quero descobrir a verdade por
        tr\xE1s de tudo! "
    - characterName: "Jo\xE3o Ningu\xE9m"
      characterImage: {fileID: 0}
      dialogueText: Assim, eu posso saber como ajudar o pessoal da ilha... Pelo menos,
        eu espero.
    - characterName: O.C.H.I.
      characterImage: {fileID: 0}
      dialogueText: "Eu sei que voc\xEA vai descobrir, meu rei. Apenas continue procurando
        conhecimento!"
