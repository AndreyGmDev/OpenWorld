  - flag: 0
    dialogueLines:
    - characterName: Placa #1
      characterImage: {fileID: 21300000, guid: 4ee18276bf9efb148944f6f2246c099f, type: 3}
      dialogueText: 'Sou uma placa. '
  - flag: 1
